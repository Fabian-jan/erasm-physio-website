---
import BaseLayout from '@/layouts/BaseLayout.astro';
import LanguageSwitcher from '@/components/LanguageSwitcher.astro';
import TodoNotice from '@/components/TodoNotice.astro';

const languages = [
  { code: 'fi' as const, label: 'Suomi', href: '/sijainti/' },
  { code: 'en' as const, label: 'English', href: '/en/access/' },
  { code: 'sv' as const, label: 'Svenska', href: '/sv/plats/' },
];
---

<BaseLayout title="Plats och vägbeskrivning — ERASM PHYSIO" lang="sv">
  <div class="mx-auto max-w-3xl px-6 py-12">
    <div class="bg-navy inline-block rounded-lg p-3">
      <LanguageSwitcher current="sv" languages={languages} />
    </div>

    <h1 class="font-heading tracking-heading text-ink mt-6 text-3xl">Plats och vägbeskrivning</h1>
    <p class="text-body mt-3 max-w-prose text-sm">ERASM PHYSIO finns i Pori, 28100, Finland.</p>

    <h2 class="font-heading tracking-heading text-ink mt-8 text-xl">Så går besöken till</h2>
    <p class="text-body mt-2 max-w-prose text-sm">
      Hem- och stallbesök (för djur), samt distansbesök.
    </p>

    <h2 class="font-heading tracking-heading text-ink mt-8 text-xl">Reseavgift</h2>
    <p class="text-body mt-2 max-w-prose text-sm">
      För hem- och stallbesök tillkommer en reseavgift på 0,40 €/km.
    </p>

    <TodoNotice label="Parkering, kollektivtrafik och tillgänglighet">
      Den exakta gatuadressen, parkeringsanvisningar, närmaste kollektivtrafik och lokalens
      tillgänglighet (PMR) saknas ännu — läggs till när Enzo har bekräftat dem.
    </TodoNotice>
  </div>
</BaseLayout>
