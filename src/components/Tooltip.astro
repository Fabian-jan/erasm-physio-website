---
interface Props {
  id: string;
  /**
   * Libellé visible du déclencheur, ex. "Pourquoi ?" — jamais une icône seule : un bouton
   * sans texte accessible échouerait au clavier comme au lecteur d'écran.
   */
  triggerLabel: string;
  /** Texte de l'infobulle. Contenu non interactif uniquement (motif toggletip APG). */
  content: string;
  class?: string;
}

const { id, triggerLabel, content, class: className } = Astro.props;
const panelId = `${id}-panel`;

const containerClasses = ['relative inline-block', className].filter(Boolean).join(' ');
---

<span class={containerClasses} data-tooltip>
  <button
    type="button"
    aria-describedby={panelId}
    data-tooltip-trigger
    class="text-navy border-navy/30 hover:bg-navy/5 inline-flex items-center gap-1 rounded-full border-2 px-3 py-1 text-xs font-bold"
  >
    <svg
      width="14"
      height="14"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2.4"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      class="shrink-0"
    >
      <circle cx="12" cy="12" r="9"></circle>
      <line x1="12" y1="11" x2="12" y2="16.5"></line>
      <circle cx="12" cy="7.5" r="0.5" fill="currentColor"></circle>
    </svg>
    {triggerLabel}
  </button>
  <span
    role="tooltip"
    id={panelId}
    hidden
    data-tooltip-panel
    class="bg-navy shadow-card z-10 w-64 rounded-lg p-3 text-xs leading-relaxed text-white"
  >
    {content}
  </span>
</span>

<script>
  // Motif "toggletip" (Inclusive Components / APG) : déclencheur = vrai bouton, contenu lié par
  // aria-describedby (pas aria-controls/aria-expanded — role="tooltip" n'est pas un widget de
  // disclosure), ouverture/fermeture au clic et au clavier natif, jamais au survol seul.
  //
  // Le panneau est déplacé dans <body> à l'ouverture et positionné en `fixed` par coordonnées
  // (même motif que Modal.astro) : un simple `position: absolute` relatif au déclencheur serait
  // rogné par le premier ancêtre `overflow: auto/hidden` rencontré — ici le conteneur défilant
  // horizontalement d'un tableau de prestations. Un `z-index` élevé ne change rien à ce
  // découpage, propriété CSS indépendante de l'empilement.
  function getPanelFor(container: HTMLElement): HTMLElement | null {
    const trigger = container.querySelector<HTMLElement>('[data-tooltip-trigger]');
    const panelId = trigger?.getAttribute('aria-describedby');
    return panelId ? document.getElementById(panelId) : null;
  }

  function closeTooltip(container: HTMLElement) {
    getPanelFor(container)?.setAttribute('hidden', '');
  }

  function openTooltip(container: HTMLElement) {
    document.querySelectorAll<HTMLElement>('[data-tooltip]').forEach((other) => {
      if (other !== container) closeTooltip(other);
    });

    const trigger = container.querySelector<HTMLElement>('[data-tooltip-trigger]');
    const panel = getPanelFor(container);
    if (!trigger || !panel) return;

    if (panel.parentElement !== document.body) {
      document.body.appendChild(panel);
    }
    const rect = trigger.getBoundingClientRect();
    panel.style.position = 'fixed';
    panel.style.top = `${rect.bottom + 8}px`;
    panel.style.left = `${rect.left}px`;
    panel.removeAttribute('hidden');
  }

  document.addEventListener('click', (event) => {
    const target = event.target as HTMLElement;
    const trigger = target.closest<HTMLElement>('[data-tooltip-trigger]');

    if (trigger) {
      const ownContainer = trigger.closest<HTMLElement>('[data-tooltip]');
      if (!ownContainer) return;
      const panel = getPanelFor(ownContainer);
      const isOpen = panel && !panel.hasAttribute('hidden');
      if (isOpen) closeTooltip(ownContainer);
      else openTooltip(ownContainer);
      return;
    }

    // Le panneau vit désormais hors de [data-tooltip] (rattaché à body) : un clic à l'intérieur
    // ne doit pas être traité comme un clic "en dehors".
    if (target.closest('[data-tooltip-panel]')) return;

    // Clic en dehors de toute infobulle ouverte : on referme (comportement toggletip standard).
    if (!target.closest('[data-tooltip]')) {
      document.querySelectorAll<HTMLElement>('[data-tooltip]').forEach(closeTooltip);
    }
  });

  function findOpenContainer(): HTMLElement | undefined {
    return Array.from(document.querySelectorAll<HTMLElement>('[data-tooltip]')).find(
      (container) => {
        const panel = getPanelFor(container);
        return panel && !panel.hasAttribute('hidden');
      },
    );
  }

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    const openContainer = findOpenContainer();
    if (!openContainer) return;
    closeTooltip(openContainer);
    openContainer.querySelector<HTMLElement>('[data-tooltip-trigger]')?.focus();
  });
</script>
