---
import BaseLayout from '@/layouts/BaseLayout.astro';
import LanguageSwitcher from '@/components/LanguageSwitcher.astro';
import ServiceAreaList from '@/components/ServiceAreaList.astro';
import { buildLocalBusiness } from '@/lib/local-business';
import { serviceZones } from '@/lib/service-area';

const languages = [
  { code: 'fi' as const, label: 'Suomi', href: '/toiminta-alue/' },
  { code: 'en' as const, label: 'English', href: '/en/service-area/' },
  { code: 'sv' as const, label: 'Svenska', href: '/sv/verksamhetsomrade/' },
];

const zoneLabels = {
  near: 'Around Pori',
  rauma: 'Rauma area',
  north: 'Northern coast',
  east: 'Eastern inland',
} as const;

const localBusiness = buildLocalBusiness({ url: Astro.url.href, inLanguage: 'en' });
---

<BaseLayout
  title="Service area — ERASM PHYSIO"
  description="ERASM PHYSIO's service area: home and stable visits within 100 km of Pori, plus remote sessions. Travel fee and covered towns."
  lang="en"
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(localBusiness)} />
  </Fragment>

  <div class="mx-auto max-w-3xl px-6 py-12">
    <div class="bg-navy inline-block rounded-lg p-3">
      <LanguageSwitcher current="en" languages={languages} />
    </div>

    <h1 class="font-heading tracking-heading text-ink mt-6 text-3xl">Service area</h1>
    <p class="text-body mt-3 max-w-prose text-sm">
      ERASM PHYSIO operates out of Pori within a 100 km radius — including Rauma, Kankaanpää, and
      Huittinen. Home and stable visits, plus remote sessions from anywhere.
    </p>

    <h2 class="font-heading tracking-heading text-ink mt-8 text-xl">How visits work</h2>
    <p class="text-body mt-2 max-w-prose text-sm">
      Home and stable visits (for animals), and remote sessions.
    </p>

    <h2 class="font-heading tracking-heading text-ink mt-8 text-xl">Travel fee</h2>
    <p class="text-body mt-2 max-w-prose text-sm">
      Home and stable visits incur a €0.40/km travel fee, regardless of visit type.
    </p>

    <ServiceAreaList heading="Towns covered" zones={serviceZones} zoneLabels={zoneLabels} />
  </div>
</BaseLayout>
