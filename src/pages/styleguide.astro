---
import Accordion from '@/components/Accordion.astro';
import Button from '@/components/Button.astro';
import FormField from '@/components/FormField.astro';
import LanguageSwitcher from '@/components/LanguageSwitcher.astro';
import Tooltip from '@/components/Tooltip.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { contrastRatio, designSystemColorPairs, MIN_CONTRAST } from '@/lib/color-contrast';
import { readColorTokens, readThemeTokens } from '@/lib/design-tokens';

const colors = readColorTokens();
const colorEntries = Object.entries(colors);

const typeScale = readThemeTokens('text');
const spacingScale = readThemeTokens('spacing');
const radiusScale = readThemeTokens('radius');
const shadowScale = readThemeTokens('shadow');

function remToPx(rem: string): string {
  const value = parseFloat(rem);
  return Number.isNaN(value) ? rem : `${Math.round(value * 16)}px`;
}
---

<BaseLayout title="Styleguide — ERASM PHYSIO" noindex>
  <div class="mx-auto max-w-3xl px-6 py-12">
    <p class="tracking-overline text-muted text-2xs font-bold uppercase">Interne — non indexé</p>
    <h1 class="font-heading tracking-heading text-ink mt-2 text-3xl">Styleguide</h1>
    <p class="text-body mt-3 max-w-prose text-sm">
      Référence vivante des tokens et composants du design system, construite au fil de l'EPIC 1. Ce
      n'est pas un écran du site : c'est le plan de travail visuel de l'équipe.
    </p>

    {/* Couleurs */}
    <section class="mt-12" aria-labelledby="colors-heading">
      <h2 id="colors-heading" class="font-heading tracking-heading text-ink text-xl">Couleurs</h2>
      <ul class="mt-4 grid grid-cols-2 gap-4 sm:grid-cols-3">
        {
          colorEntries.map(([name, hex]) => (
            <li class="flex flex-col gap-2">
              <span
                class="h-16 w-full rounded-xl border border-black/10"
                style={`background-color:${hex}`}
                aria-hidden="true"
              />
              <span class="text-ink text-sm font-bold">{name}</span>
              <span class="text-muted font-mono text-xs">{hex}</span>
            </li>
          ))
        }
      </ul>

      <h3 class="font-heading tracking-heading text-ink mt-8 text-lg">Paires validées (E1-US2)</h3>
      <ul class="mt-4 flex flex-col gap-2">
        {
          designSystemColorPairs.map((pair) => {
            const ratio = contrastRatio(colors[pair.foreground], colors[pair.background]);
            const min = MIN_CONTRAST[pair.level];
            const passes = ratio >= min;
            return (
              <li class="flex items-center gap-4 rounded-lg border border-black/10 p-3">
                <span
                  class="flex h-10 w-16 shrink-0 overflow-hidden rounded-md border border-black/10"
                  aria-hidden="true"
                >
                  <span
                    class="h-full w-1/2"
                    style={`background-color:${colors[pair.background]}`}
                  />
                  <span
                    class="h-full w-1/2"
                    style={`background-color:${colors[pair.foreground]}`}
                  />
                </span>
                <span class="flex-1">
                  <span class="text-ink block text-sm font-bold">{pair.name}</span>
                  <span class="text-muted block text-xs">
                    {ratio.toFixed(2)}:1 — seuil {min}:1 —{' '}
                    {passes ? 'conforme' : 'refusé (attendu)'}
                  </span>
                </span>
              </li>
            );
          })
        }
      </ul>
    </section>

    {/* Typographie */}
    <section class="mt-12" aria-labelledby="type-heading">
      <h2 id="type-heading" class="font-heading tracking-heading text-ink text-xl">Typographie</h2>
      <ul class="mt-4 flex flex-col gap-3">
        {
          typeScale.map((token) => (
            <li class="flex items-baseline gap-4 border-b border-black/5 pb-3">
              <span class="text-muted w-12 shrink-0 font-mono text-xs">{token.name}</span>
              {/* style plutôt qu'une classe Tailwind : le nom du palier est une donnée
                  (boucle sur readThemeTokens), pas une chaîne littérale — le scanner JIT de
                  Tailwind ne détecterait pas `text-${token.name}` construit dynamiquement. */}
              <span class="text-ink flex-1" style={`font-size:${token.value}`}>
                Erasm Physio — Pori
              </span>
              <span class="text-muted shrink-0 font-mono text-xs">{remToPx(token.value)}</span>
            </li>
          ))
        }
      </ul>

      <h3 class="font-heading tracking-heading text-ink mt-8 text-lg">Motifs composés</h3>
      <p class="text-body mt-2 text-sm">
        Le suivi de lettres est un motif indépendant de la taille — un titre reste{' '}
        <code class="font-mono">tracking-heading</code> qu'il soit en{' '}
        <code class="font-mono">text-2xl</code> ou <code class="font-mono">text-4xl</code>.
      </p>
      <p class="font-heading tracking-heading text-ink mt-4 text-2xl">Titre de section</p>
      <p class="tracking-overline text-muted text-2xs mt-3 font-bold uppercase">
        Sur-titre sur fond clair
      </p>
      <div class="bg-navy mt-3 rounded-lg p-4">
        <p class="tracking-overline text-cyan text-2xs font-bold uppercase">
          Sur-titre sur fond marine
        </p>
      </div>
    </section>

    {/* Espacement */}
    <section class="mt-12" aria-labelledby="spacing-heading">
      <h2 id="spacing-heading" class="font-heading tracking-heading text-ink text-xl">
        Espacement
      </h2>
      <p class="text-body mt-2 max-w-prose text-sm">
        Paliers nommés, préfixés <code class="font-mono">ds-</code> (design system) pour ne jamais pouvoir
        écraser un nom réservé par l'échelle native de Tailwind (
        <code class="font-mono">sm</code>, <code class="font-mono">lg</code>,{' '}
        <code class="font-mono">3xl</code>… voir <code class="font-mono">
          tests/unit/token-collisions.test.ts
        </code>
        ). Utilisables via <code class="font-mono">p-ds-*</code>,{' '}
        <code class="font-mono">gap-ds-*</code>, <code class="font-mono">m-ds-*</code>, etc.
      </p>
      <ul class="mt-4 flex flex-col gap-3">
        {
          spacingScale.map((token) => (
            <li class="flex items-center gap-4">
              <span class="text-ink w-16 shrink-0 font-mono text-xs">{token.name}</span>
              <span
                class="bg-navy h-4 rounded-full"
                style={`width:${token.value}`}
                aria-hidden="true"
              />
              <span class="text-muted shrink-0 font-mono text-xs">{remToPx(token.value)}</span>
            </li>
          ))
        }
      </ul>
    </section>

    {/* Rayons */}
    <section class="mt-12" aria-labelledby="radius-heading">
      <h2 id="radius-heading" class="font-heading tracking-heading text-ink text-xl">Rayons</h2>
      <ul class="mt-4 flex flex-wrap gap-6">
        {
          radiusScale.map((token) => (
            <li class="flex flex-col items-center gap-2">
              <span
                class="border-navy bg-surface h-16 w-16 border-2"
                style={`border-radius:${token.value}`}
                aria-hidden="true"
              />
              <span class="text-ink text-xs font-bold">{token.name}</span>
              <span class="text-muted font-mono text-xs">{token.value}</span>
            </li>
          ))
        }
      </ul>
    </section>

    {/* Ombres */}
    <section class="mt-12" aria-labelledby="shadow-heading">
      <h2 id="shadow-heading" class="font-heading tracking-heading text-ink text-xl">Ombres</h2>
      <ul class="mt-6 flex flex-wrap gap-8">
        {
          shadowScale.map((token) => (
            <li class="flex flex-col items-center gap-3">
              <span
                class="h-20 w-32 rounded-xl bg-white"
                style={`box-shadow:${token.value}`}
                aria-hidden="true"
              />
              <span class="text-ink text-xs font-bold">{token.name}</span>
            </li>
          ))
        }
      </ul>
    </section>

    {/* Mouvement */}
    <section class="mt-12" aria-labelledby="motion-heading">
      <h2 id="motion-heading" class="font-heading tracking-heading text-ink text-xl">Mouvement</h2>
      <p class="text-body mt-3 max-w-prose text-sm">
        Règle globale (E1-US5), pas de cas par cas : sous{' '}
        <code class="font-mono">prefers-reduced-motion: reduce</code>, toute transition et animation
        — présente ou future, sur n'importe quel composant — passe automatiquement à une durée quasi
        nulle. Rien à ajouter composant par composant ; voir le bloc{' '}
        <code class="font-mono">@media (prefers-reduced-motion: reduce)</code> dans{' '}
        <code class="font-mono">global.css</code>.
      </p>
    </section>

    {/* Composants */}
    <section class="mt-12" aria-labelledby="components-heading">
      <h2 id="components-heading" class="font-heading tracking-heading text-ink text-xl">
        Composants
      </h2>
      <p class="text-body mt-3 text-sm">
        Construits un par un au fil de l'EPIC 1 (E1-US4a à E1-US4f). Reste à venir : modale.
      </p>

      <h3 class="font-heading tracking-heading text-ink mt-8 text-lg">Bouton</h3>
      <p class="text-body mt-2 max-w-prose text-sm">
        <code class="font-mono">primary</code> pour l'action principale d'un écran (une par écran, en
        règle générale) ; <code class="font-mono">secondary</code> pour une action de poids équivalent
        ; <code class="font-mono">outline</code> pour une action tertiaire. L'état{' '}
        <code class="font-mono">disabled</code> sert aux prestations non réservables (en attente de l'autorisation
        Valvira, CLAUDE.md) : le bouton reste visible, focusable et annoncé par les lecteurs d'écran via{
          ' '
        }
        <code class="font-mono">aria-disabled="true"</code>, jamais l'attribut{' '}
        <code class="font-mono">disabled</code> qui le sortirait de l'ordre de tabulation. Le blocage
        du clic/clavier est une défense côté client (voir le script de Button.astro) — une vraie action
        de réservation devra aussi être bloquée côté serveur.
      </p>
      <div class="mt-4 flex flex-wrap items-center gap-4">
        <Button variant="primary">Réserver</Button>
        <Button variant="secondary">Réserver</Button>
        <Button variant="outline">En savoir plus</Button>
        <Button disabled>1:1 Physiotherapy Session</Button>
      </div>

      <div class="mt-6 rounded-lg border border-black/10 p-4">
        <p class="text-ink text-xs font-bold">
          Preuve manuelle — le clic est bloqué à l'état désactivé
        </p>
        <p class="text-muted mt-1 text-xs">
          Compteur (démo, pas un vrai composant) : <span id="button-demo-count">0</span>
        </p>
        <div class="mt-3 flex flex-wrap gap-3">
          <Button variant="secondary" class="js-demo-count" data-testid="button-enabled-demo">
            Actif — incrémente
          </Button>
          <Button disabled class="js-demo-count" data-testid="button-disabled-demo">
            Désactivé — ne doit rien faire
          </Button>
        </div>
      </div>

      <h3 class="font-heading tracking-heading text-ink mt-10 text-lg">Champ de formulaire</h3>
      <p class="text-body mt-2 max-w-prose text-sm">
        Label toujours associé via <code class="font-mono">for</code>/<code class="font-mono">
          id
        </code>{' '}
        (jamais de placeholder en guise de label). Description et erreur partagent un seul{' '}
        <code class="font-mono">aria-describedby</code> (liste d'ids séparés par un espace). L'erreur
        porte <code class="font-mono">role="alert"</code> (annoncée dès son insertion) et{' '}
        <code class="font-mono">aria-invalid="true"</code> sur le champ — jamais la couleur seule pour
        la signaler : la palette du design system n'a pas de couleur d'erreur dédiée (CLAUDE.md, six tokens),
        donc bordure marquée + icône + texte.
      </p>

      <div class="mt-4 grid max-w-md grid-cols-1 gap-6">
        <FormField id="fg-name" label="Nom complet" required autocomplete="name" />
        <FormField
          id="fg-email"
          label="Email"
          type="email"
          description="Pour t'envoyer la confirmation."
          required
          autocomplete="email"
        />
        <FormField
          id="fg-phone-error"
          label="Téléphone"
          type="tel"
          error="Ce champ est requis."
          autocomplete="tel"
        />
      </div>

      <div class="border-navy mt-8 rounded-lg border-l-4 bg-white p-4">
        <p class="text-ink text-xs font-bold">
          ⚠ Aucune donnée de santé — le premier endroit où la règle rencontre du code
        </p>
        <div class="text-body mt-3 flex flex-col gap-3 text-xs leading-relaxed">
          <p>
            <code class="font-mono">type="textarea"</code> existe pour un seul usage : le formulaire de
            contact (E6-US1), un contexte strictement administratif. Il est{' '}
            <strong>interdit</strong> partout dans le parcours de réservation (E5-US3) — aucun champ «
            décrivez votre blessure », aucune puce de zone corporelle, décision du 13/08/2026, définitive.
          </p>
          <p>
            <strong>La règle ne porte pas sur le widget, elle porte sur la question posée.</strong>{
              ' '
            }
            Un <code class="font-mono">type="text"</code> mono-ligne avec pour label « Décrivez vos symptômes
            » est tout aussi interdit qu'un <code class="font-mono">textarea</code> — ce n'est pas la
            présence d'une zone de texte libre qui pose problème, c'est le fait qu'elle invite une réponse
            de santé. Avant d'ajouter un champ n'importe où dans le site, la question à se poser n'est
            pas « est-ce un textarea ? » mais « une réponse plausible à ce label pourrait-elle décrire
            un état de santé ? ». Si oui, le champ ne doit pas exister, quel que soit le composant utilisé
            pour le rendre.
          </p>
          <p>
            Tout champ libre en contexte administratif (contact, message général) doit porter un
            avertissement visible — pas seulement dans un texte légal en bas de page. Démo
            ci-dessous : c'est le texte exact à reprendre, pas un exemple à reformuler.
          </p>
        </div>
        <div class="mt-4 max-w-md">
          <FormField
            id="fg-message"
            label="Message"
            type="textarea"
            rows={4}
            description="N'indiquez pas d'informations de santé dans ce formulaire."
            placeholder="Comment puis-je vous aider ?"
          />
        </div>
      </div>

      <h3 class="font-heading tracking-heading text-ink mt-10 text-lg">Accordéon</h3>
      <p class="text-body mt-2 max-w-prose text-sm">
        Motif APG standard : <code class="font-mono">button[aria-expanded][aria-controls]</code>{
          ' '
        }
        dans un <code class="font-mono">h3</code>, panneau en{' '}
        <code class="font-mono">role="region"[aria-labelledby]</code>, cadré par{' '}
        <code class="font-mono">hidden</code> plutôt qu'un jeu de classes CSS — retire vraiment le panneau
        fermé de l'arbre d'accessibilité et de l'ordre de tabulation, pas seulement de l'affichage. Clavier
        : Tab + Entrée/Espace, gratuits parce que ce sont de vrais{' '}
        <code class="font-mono">button</code>. La navigation flèches Haut/Bas entre en-têtes (motif
        APG complet) n'est pas implémentée — Tab suffit au critère « navigable au clavier »,
        extension possible plus tard si un vrai besoin apparaît.
      </p>
      <p class="text-body mt-2 max-w-prose text-sm">
        Par défaut (<code class="font-mono">allowMultiple=false</code>), ouvrir un panneau ferme les
        autres — comportement de la maquette pour la liste des prestations. Ne jamais y cacher une
        information obligatoire que l'utilisateur doit forcément lire : un accordéon replié est, par
        construction, invisible pour qui ne pense pas à l'ouvrir.
      </p>
      <div class="mt-4 max-w-md">
        <Accordion
          id="faq-demo"
          items={[
            {
              id: 'hours',
              title: 'Quels sont vos horaires ?',
              content: 'Lundi à vendredi, 8h à 18h. Samedi sur arrangement, fermé le dimanche.',
            },
            {
              id: 'location',
              title: 'Où se trouve le studio ?',
              content:
                'À Pori (28100), Finlande. Visites à domicile et en écurie également possibles.',
            },
            {
              id: 'cancel',
              title: 'Comment annuler un rendez-vous ?',
              content: 'Gratuitement jusqu’à 24 heures avant le rendez-vous.',
            },
          ]}
        />
      </div>

      <h3 class="font-heading tracking-heading text-ink mt-10 text-lg">Sélecteur de langue</h3>
      <p class="text-body mt-2 max-w-prose text-sm">
        Trois pages distinctes (FI/EN/SV, URL localisées à venir en EPIC 3), pas un widget
        d'application : de vrais liens (<code class="font-mono">a[href]</code>), pas des boutons. La
        langue active porte <code class="font-mono">aria-current="page"</code> — la valeur correcte pour
        « élément courant dans un ensemble de pages liées », pas{' '}
        <code class="font-mono">aria-current="true"</code>. Chaque lien porte{' '}
        <code class="font-mono">hreflang</code> et <code class="font-mono">lang</code> sur son propre
        code de langue, pour que le nom soit prononcé correctement par un lecteur d'écran. Libellés toujours
        en autonyme (« Svenska », jamais « Suédois ») — jamais traduits dans la langue de la page courante.
      </p>
      <div class="bg-navy mt-4 inline-block rounded-lg p-4">
        <LanguageSwitcher
          current="fi"
          languages={[
            { code: 'fi', label: 'Suomi', href: '#lang-fi' },
            { code: 'en', label: 'English', href: '#lang-en' },
            { code: 'sv', label: 'Svenska', href: '#lang-sv' },
          ]}
        />
      </div>

      <h3 class="font-heading tracking-heading text-ink mt-10 text-lg">Infobulle</h3>
      <p class="text-body mt-2 max-w-prose text-sm">
        Motif « toggletip » (APG / Inclusive Components), pas un vrai{' '}
        <code class="font-mono">role="tooltip"</code> déclenché au survol : ici le contenu compte (explication
        de l'attente Valvira, E5-US11), donc il lui faut un déclencheur atteignable au clavier et au tap.
        Un <code class="font-mono">button</code> réel, jamais{' '}
        <code class="font-mono">title</code> HTML (invisible au clavier, au tactile, et à la plupart des
        lecteurs d'écran) ni un survol seul. Le contenu est lié par{' '}
        <code class="font-mono">aria-describedby</code>, pas{' '}
        <code class="font-mono">aria-controls</code>/<code class="font-mono">aria-expanded</code> — ce
        n'est pas un widget de disclosure. Fermeture à <code class="font-mono">Échap</code>, avec
        restitution du focus au déclencheur ; ouvrir une infobulle ferme celle déjà ouverte (une
        seule à la fois, comme l'accordéon).
      </p>
      <p class="text-body mt-2 max-w-prose text-sm">
        C'est ce composant qui portera l'explication de chaque prestation non réservable
        (E5-US10/US11). Le texte ci-dessous est le texte français de référence du brief (§6ter point
        3) — les versions EN et SV restent <code class="font-mono">TODO</code>, à traduire par un
        humain avant intégration réelle dans les fiches de prestation, pas par traduction
        automatique.
      </p>
      <div class="mt-4 flex flex-wrap items-center gap-4">
        <Button disabled>1:1 Physiotherapy Session</Button>
        <Tooltip
          id="tooltip-demo"
          triggerLabel="Pourquoi ?"
          content="Cette prestation n'est pas encore réservable. Je termine mes études de kinésithérapie et l'autorisation d'exercice finlandaise est requise avant de proposer des séances de kinésithérapie. Le coaching de force, le coaching en ligne et la rééducation animale restent disponibles."
        />
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  // Démo locale à la page, pour rendre le blocage de clic observable (à l'œil et dans le
  // test Playwright dédié) — ne fait pas partie du composant Button lui-même.
  let count = 0;
  const counter = document.getElementById('button-demo-count');
  document.querySelectorAll('.js-demo-count').forEach((button) => {
    button.addEventListener('click', () => {
      count += 1;
      if (counter) counter.textContent = String(count);
    });
  });
</script>
