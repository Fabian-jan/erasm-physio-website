---
import BaseLayout from '@/layouts/BaseLayout.astro';
import LanguageSwitcher from '@/components/LanguageSwitcher.astro';
import Button from '@/components/Button.astro';
import Tooltip from '@/components/Tooltip.astro';
import HreflangLinks from '@/components/HreflangLinks.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import { prestations, parsePrestationPrice, type Prestation } from '@/lib/prestations';
import { buildBreadcrumbList } from '@/lib/breadcrumbs';

export function getStaticPaths() {
  return prestations.map((prestation) => ({
    params: { slug: prestation.slug.en },
    props: { prestation },
  }));
}

interface Props {
  prestation: Prestation;
}

const { prestation } = Astro.props;
const paragraphs = prestation.description.en.split('\n\n');

const languages = [
  { code: 'fi' as const, label: 'Suomi', href: `/palvelut/${prestation.slug.fi}/` },
  { code: 'en' as const, label: 'English', href: `/en/services/${prestation.slug.en}/` },
  { code: 'sv' as const, label: 'Svenska', href: `/sv/tjanster/${prestation.slug.sv}/` },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: prestation.name.en,
  description: prestation.description.en.split('\n\n')[0],
  provider: { '@type': 'LocalBusiness', name: 'ERASM PHYSIO' },
  areaServed: { '@type': 'City', name: 'Pori' },
  offers: prestation.variants.en.map((v) => ({
    '@type': 'Offer',
    price: parsePrestationPrice(v.price),
    priceCurrency: 'EUR',
  })),
  url: Astro.url.href,
  inLanguage: 'en',
};

const mailSubject = encodeURIComponent(`Booking request: ${prestation.name.en}`);

const breadcrumbItems = [
  { label: 'Home', href: '/en/' },
  { label: 'Pricing', href: '/en/pricing/' },
  { label: prestation.name.en },
];
const breadcrumbList = buildBreadcrumbList(
  breadcrumbItems.map((item) => ({
    name: item.label,
    url: new URL(item.href ?? Astro.url.pathname, Astro.url.origin).href,
  })),
);
---

<BaseLayout
  title={`${prestation.name.en} — ERASM PHYSIO`}
  description={paragraphs[0].slice(0, 155)}
  lang="en"
>
  <Fragment slot="head">
    <HreflangLinks languages={languages} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbList)} />
  </Fragment>

  <div class="mx-auto max-w-3xl px-6 py-12">
    <div class="bg-navy inline-block rounded-lg p-3">
      <LanguageSwitcher current="en" languages={languages} />
    </div>

    <Breadcrumb items={breadcrumbItems} navLabel="Breadcrumb" />

    <h1 class="font-heading tracking-heading text-ink mt-6 text-3xl">{prestation.name.en}</h1>

    <ul class="mt-4 flex flex-wrap gap-3">
      {
        prestation.variants.en.map((variant) => (
          <li class="border-navy/20 text-ink rounded-full border-2 px-4 py-1.5 text-sm font-bold">
            {variant.duration} · {variant.price}
          </li>
        ))
      }
    </ul>

    <div class="mt-6 max-w-prose">
      {paragraphs.map((paragraph) => <p class="text-body mt-3 text-sm">{paragraph}</p>)}
    </div>

    <div class="mt-6">
      {
        prestation.bookable ? (
          <Button variant="primary" href={`mailto:erasmphysio@gmail.com?subject=${mailSubject}`}>
            Book by email
          </Button>
        ) : (
          <div class="flex flex-wrap items-center gap-4">
            <Button disabled>{prestation.name.en}</Button>
            <Tooltip
              id={`tooltip-${prestation.id}`}
              triggerLabel="Why?"
              content="This service isn't bookable yet. I'm completing my physiotherapy studies, and a Finnish practice licence is required before I can offer physiotherapy sessions. Massage, coaching programmes, and animal massage remain available."
            />
          </div>
        )
      }
    </div>
  </div>
</BaseLayout>
