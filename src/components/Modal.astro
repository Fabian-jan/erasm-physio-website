---
interface Props {
  id: string;
  triggerLabel: string;
  titleText: string;
  class?: string;
}

const { id, triggerLabel, titleText, class: className } = Astro.props;
const backdropId = `${id}-backdrop`;
const dialogId = `${id}-dialog`;
const titleId = `${id}-title`;

const triggerClasses = [
  'bg-navy inline-flex items-center justify-center gap-2 rounded-lg px-6 py-3 text-sm font-bold text-white hover:brightness-125',
  className,
]
  .filter(Boolean)
  .join(' ');
---

<button
  type="button"
  aria-haspopup="dialog"
  data-modal-trigger
  data-modal-target={backdropId}
  class={triggerClasses}
>
  {triggerLabel}
</button>

<div
  id={backdropId}
  data-modal-backdrop
  hidden
  class="fixed inset-0 z-50 flex items-center justify-center bg-black/60 p-4"
>
  <div
    id={dialogId}
    role="dialog"
    aria-modal="true"
    aria-labelledby={titleId}
    data-modal-dialog
    tabindex="-1"
    class="bg-surface shadow-card max-h-[90vh] w-full max-w-md overflow-y-auto rounded-xl p-6"
  >
    <div class="flex items-start justify-between gap-4">
      <h2 id={titleId} class="font-heading tracking-heading text-ink text-lg">{titleText}</h2>
      <button
        type="button"
        data-modal-close
        aria-label="Fermer la fenêtre"
        class="text-muted shrink-0 rounded-full p-1.5 hover:bg-black/5"
      >
        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.4"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <line x1="6" y1="6" x2="18" y2="18"></line>
          <line x1="18" y1="6" x2="6" y2="18"></line>
        </svg>
      </button>
    </div>
    <div class="text-body mt-4 text-sm leading-relaxed">
      <slot />
    </div>
  </div>
</div>

<script>
  // Motif dialog modal APG. Trois garanties, indépendantes du rendu natif de <dialog> (dont le
  // piégeage de focus varie selon les navigateurs) : piège de focus explicite au clavier, inert
  // sur le reste du document tant que la modale est ouverte, restitution du focus au déclencheur
  // à la fermeture — vérifiable et testable sans dépendre du comportement natif.
  interface OpenModalState {
    backdrop: HTMLElement;
    trigger: HTMLElement;
    inertedSiblings: HTMLElement[];
  }

  let openState: OpenModalState | null = null;

  function getFocusable(container: HTMLElement): HTMLElement[] {
    return Array.from(
      container.querySelectorAll<HTMLElement>(
        'a[href], button:not([disabled]), textarea:not([disabled]), input:not([disabled]), select:not([disabled]), [tabindex]:not([tabindex="-1"])',
      ),
    );
  }

  function reparentToBody(backdrop: HTMLElement) {
    // Rattaché à <body> plutôt que laissé dans son conteneur d'origine : évite qu'un ancêtre
    // avec overflow/transform ne le recadre ou ne casse son positionnement fixed.
    if (backdrop.parentElement !== document.body) {
      document.body.appendChild(backdrop);
    }
  }

  function openModal(backdrop: HTMLElement, trigger: HTMLElement) {
    reparentToBody(backdrop);

    const inertedSiblings: HTMLElement[] = [];
    Array.from(document.body.children).forEach((child) => {
      if (!(child instanceof HTMLElement) || child === backdrop) return;
      if (!child.hasAttribute('inert')) {
        child.setAttribute('inert', '');
        inertedSiblings.push(child);
      }
    });

    openState = { backdrop, trigger, inertedSiblings };
    backdrop.removeAttribute('hidden');
    backdrop.querySelector<HTMLElement>('[data-modal-dialog]')?.focus();
  }

  function closeModal() {
    if (!openState) return;
    const { backdrop, trigger, inertedSiblings } = openState;
    backdrop.setAttribute('hidden', '');
    inertedSiblings.forEach((el) => el.removeAttribute('inert'));
    trigger.focus();
    openState = null;
  }

  document.addEventListener('click', (event) => {
    const target = event.target as HTMLElement;

    const trigger = target.closest<HTMLElement>('[data-modal-trigger]');
    if (trigger) {
      const targetId = trigger.getAttribute('data-modal-target');
      const backdrop = targetId ? document.getElementById(targetId) : null;
      if (backdrop) openModal(backdrop, trigger);
      return;
    }

    if (target.closest('[data-modal-close]')) {
      closeModal();
      return;
    }

    // Clic sur le fond lui-même (pas sur le panneau) : ferme, comportement standard des modales.
    if (target.hasAttribute('data-modal-backdrop')) {
      closeModal();
    }
  });

  document.addEventListener('keydown', (event) => {
    if (!openState) return;

    if (event.key === 'Escape') {
      closeModal();
      return;
    }

    if (event.key !== 'Tab') return;

    const dialog = openState.backdrop.querySelector<HTMLElement>('[data-modal-dialog]');
    if (!dialog) return;

    const focusable = getFocusable(dialog);
    if (focusable.length === 0) {
      event.preventDefault();
      dialog.focus();
      return;
    }

    const first = focusable[0];
    const last = focusable[focusable.length - 1];
    const active = document.activeElement;

    if (event.shiftKey && (active === first || active === dialog)) {
      event.preventDefault();
      last.focus();
    } else if (!event.shiftKey && active === last) {
      event.preventDefault();
      first.focus();
    }
  });
</script>
