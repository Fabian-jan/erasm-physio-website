---
import BaseLayout from '@/layouts/BaseLayout.astro';
import LanguageSwitcher from '@/components/LanguageSwitcher.astro';
import ServiceAreaList from '@/components/ServiceAreaList.astro';
import { buildLocalBusiness } from '@/lib/local-business';
import { serviceZones } from '@/lib/service-area';

const languages = [
  { code: 'fi' as const, label: 'Suomi', href: '/toiminta-alue/' },
  { code: 'en' as const, label: 'English', href: '/en/service-area/' },
  { code: 'sv' as const, label: 'Svenska', href: '/sv/verksamhetsomrade/' },
];

const zoneLabels = {
  near: 'Närområdet',
  rauma: 'Raumatrakten',
  north: 'Norra kusten',
  east: 'Östra inlandet',
} as const;

const localBusiness = buildLocalBusiness({ url: Astro.url.href, inLanguage: 'sv' });
---

<BaseLayout
  title="Verksamhetsområde — ERASM PHYSIO"
  description="ERASM PHYSIOs verksamhetsområde: hem- och stallbesök inom 100 km från Pori, samt distansbesök. Reseavgift och kommuner som omfattas."
  lang="sv"
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(localBusiness)} />
  </Fragment>

  <div class="mx-auto max-w-3xl px-6 py-12">
    <div class="bg-navy inline-block rounded-lg p-3">
      <LanguageSwitcher current="sv" languages={languages} />
    </div>

    <h1 class="font-heading tracking-heading text-ink mt-6 text-3xl">Verksamhetsområde</h1>
    <p class="text-body mt-3 max-w-prose text-sm">
      ERASM PHYSIO utgår från Pori inom en radie på 100 km — bland annat Rauma, Kankaanpää och
      Huittinen ingår i verksamhetsområdet. Hem- och stallbesök, samt distansbesök varifrån som
      helst.
    </p>

    <h2 class="font-heading tracking-heading text-ink mt-8 text-xl">Så går besöken till</h2>
    <p class="text-body mt-2 max-w-prose text-sm">
      Hem- och stallbesök (för djur), samt distansbesök.
    </p>

    <h2 class="font-heading tracking-heading text-ink mt-8 text-xl">Reseavgift</h2>
    <p class="text-body mt-2 max-w-prose text-sm">
      För hem- och stallbesök tillkommer en reseavgift på 0,40 €/km, oavsett besökstyp.
    </p>

    <ServiceAreaList
      heading="Kommuner i verksamhetsområdet"
      zones={serviceZones}
      zoneLabels={zoneLabels}
    />
  </div>
</BaseLayout>
