---
import BaseLayout from '@/layouts/BaseLayout.astro';
import LanguageSwitcher from '@/components/LanguageSwitcher.astro';
import TodoNotice from '@/components/TodoNotice.astro';

const languages = [
  { code: 'fi' as const, label: 'Suomi', href: '/sijainti/' },
  { code: 'en' as const, label: 'English', href: '/en/access/' },
  { code: 'sv' as const, label: 'Svenska', href: '/sv/plats/' },
];
---

<BaseLayout title="Sijainti ja saapuminen — ERASM PHYSIO" lang="fi">
  <div class="mx-auto max-w-3xl px-6 py-12">
    <div class="bg-navy inline-block rounded-lg p-3">
      <LanguageSwitcher current="fi" languages={languages} />
    </div>

    <h1 class="font-heading tracking-heading text-ink mt-6 text-3xl">Sijainti ja saapuminen</h1>
    <p class="text-body mt-3 max-w-prose text-sm">ERASM PHYSIO toimii Porissa (28100), Suomessa.</p>

    <h2 class="font-heading tracking-heading text-ink mt-8 text-xl">Vastaanottotavat</h2>
    <p class="text-body mt-2 max-w-prose text-sm">
      Käynnit kotiin ja talliin (eläimille), sekä etävastaanotto.
    </p>

    <h2 class="font-heading tracking-heading text-ink mt-8 text-xl">Matkakulu</h2>
    <p class="text-body mt-2 max-w-prose text-sm">
      Koti- ja tallikäynneistä veloitetaan 0,40 €/km.
    </p>

    <TodoNotice label="Pysäköinti, julkinen liikenne ja esteettömyys">
      Tarkka katuosoite, pysäköintiohjeet, lähimmät julkisen liikenteen yhteydet ja tilan
      esteettömyys (PMR) puuttuvat vielä — täydennetään, kun Enzo on vahvistanut ne.
    </TodoNotice>
  </div>
</BaseLayout>
